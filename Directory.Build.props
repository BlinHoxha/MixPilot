<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SDK 10 audits transitive AutoMapper 12 advisories in MixPilot projects. Keep NU1903 visible until FW-AM-001. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
    <FrameworkRoot Condition="'$(FrameworkRoot)' == ''">$(MSBuildThisFileDirectory)..\Framework</FrameworkRoot>
    <AIFrameworkRoot Condition="'$(AIFrameworkRoot)' == ''">$(MSBuildThisFileDirectory)..\AI-Framework</AIFrameworkRoot>
  </PropertyGroup>
</Project>
